href=\"https://www.instagram.com/sydneyhotwatersystems.com.au/\" rel=\"noopener\" target=\"_blank\" aria-label=\"Sydney Hot Water Systems on Instagram\"><svg class=\"ic\" aria-hidden=\"true\"><use href=\"#i-ig-f\"></use></svg></a>\n        <a href=\"https://x.com/SydneySystems\" rel=\"noopener\" target=\"_blank\" aria-label=\"Sydney Hot Water Systems on X\"><svg class=\"ic\" aria-hidden=\"true\"><use href=\"#i-x-f\"></use></svg></a>\n        <a href=\"https://www.youtube.com/channel/UCqZ6_vDFDvFXIxGMNXbPAyA\" rel=\"noopener\" target=\"_blank\" aria-label=\"Sydney Hot Water Systems on YouTube\"><svg class=\"ic\" aria-hidden=\"true\"><use href=\"#i-yt-f\"></use></svg></a>\n        <a href=\"/contact-us/\" aria-label=\"Contact Sydney Hot Water Systems\"><svg class=\"ic\" aria-hidden=\"true\"><use href=\"#i-mail-f\"></use></svg></a>\n        <a href=\"tel:1300096668\" aria-label=\"Call Sydney Hot Water Systems on 1300 096 668\"><svg class=\"ic\" aria-hidden=\"true\"><use href=\"#i-phone-f\"></use></svg></a>\n      </div>\n    </div>\n    <div>\n      <h3>Services</h3>\n      <ul>\n        <li><a href=\"/services/hot-water-installation/\" data-route-status=\"proposed\">Hot Water Installation</a></li>\n        <li><a href=\"/services/hot-water-repairs/\" data-route-status=\"proposed\">Hot Water Repairs</a></li>\n        <li><a href=\"/services/hot-water-system-replacement/\" data-route-status=\"proposed\">Hot Water Replacement</a></li>\n        <li><a href=\"/services/hot-water-servicing/\" data-route-status=\"proposed\">Servicing &amp; Maintenance</a></li>\n        <li><a href=\"/services/emergency-hot-water-repairs/\" data-route-status=\"proposed\">Emergency Repairs</a></li>\n        <li><a href=\"/services/solar-hot-water/\" data-route-status=\"proposed\">Solar Hot Water</a></li>\n        <li><a href=\"/commercial-hot-water-system/\">Commercial Hot Water</a></li>\n      </ul>\n    </div>\n    <div>\n      <h3>System Types</h3>\n      <ul>\n        <li><a href=\"/product-category/gas/\">Gas Hot Water</a></li>\n        <li><a class=\"sub\" href=\"/product-category/instant-gas/\">Instant Gas &amp; Continuous Flow</a></li>\n        <li><a href=\"/product-category/electric/\">Electric Hot Water</a></li>\n        <li><a class=\"sub\" href=\"/product-category/heat-pump/\">Heat Pump Hot Water</a></li>\n      </ul>\n      <h3 class=\"after-grid\">Brands</h3>\n      <ul>\n        <li class=\"f-brands\"><a href=\"/brand/rheem/\">Rheem</a><a href=\"/brand/rinnai/\">Rinnai</a><a href=\"/brand/dux/\">Dux</a><a href=\"/brand/aquamax/\">Aquamax</a><a href=\"/brand/thermann/\">Thermann</a><a href=\"/brand/evoheat/\">Evoheat</a></li>\n        <li><a href=\"/shop/\">Brands We Supply</a></li>\n      </ul>\n    </div>\n    <div>\n      <h3>Contact</h3>\n      <ul class=\"f-contact\">\n        <li><svg class=\"ic\" aria-hidden=\"true\"><use href=\"#i-phone-f\"></use></svg><a href=\"tel:1300096668\">1300 096 668</a></li>\n        <li><svg class=\"ic\" aria-hidden=\"true\"><use href=\"#i-mail-f\"></use></svg><a href=\"mailto:info@sydneyhotwatersystems.com.au\">info@sydneyhotwatersystems.com.au</a></li>\n        <li><svg class=\"ic\" aria-hidden=\"true\"><use href=\"#i-pin-f\"></use></svg><span>93B John St<br>Lidcombe NSW 2141</span></li>\n        <li><svg class=\"ic\" aria-hidden=\"true\"><use href=\"#i-clock-f\"></use></svg><span>Phone attended 24 hours</span></li>\n      </ul>\n      <h3 class=\"after-grid\">Areas</h3>\n      <ul>\n        <li><a href=\"/locations/nsw/\" data-route-status=\"proposed\">All Sydney areas we serve</a></li>\n      </ul>\n    </div>\n  </div>\n  <div class=\"wrap f-bar\">\n    <p>© <span id=\"yr\">2026</span> Sydney Hot Water Systems. All rights reserved.</p>\n    <ul>\n      <li><a href=\"/about-us/\">About</a></li>\n      <li><a href=\"/contact-us/\">Contact</a></li>\n      <li><a href=\"/privacy-policy/\">Privacy Policy</a></li>\n      <li><a href=\"/terms-and-conditions/\">Terms &amp; Conditions</a></li>\n      <li><a href=\"/shipping-return-policy/\">Shipping &amp; Returns</a></li>\n    </ul>\n    <span class=\"built\"><img src=\"data:image/png;base64,\" width=\"20\" height=\"20\" alt=\"Nifty Websites AI\">Crafted by <b>Nifty Websites AI</b></span>\n  </div>\n\n<style>\n:root{\n  --navy:#20386e; --navy-900:#0d1426; --navy-800:#121c33; --navy-700:#1a2b55;\n  --navy-600:#2b4a8c; --navy-400:#5f7cb8; --navy-300:#93a8d2; --navy-50:#eef2f9;\n  --red:#cb4236; --red-700:#a3332a; --red-600:#b93a2f; --red-300:#e8776c; --red-50:#fdefed;\n  --ink:#101728; --body:#5f6877; --muted:#7a8496;\n  --line:#e5e9f1; --line-2:#ccd4e2; --line-dark:rgba(255,255,255,.14);\n  --paper:#ffffff; --paper-2:#f5f7fb; --paper-3:#eef2f8;\n  --d-ink:#ffffff; --d-body:#c4d0e6; --d-muted:#8e9cba;\n  --r-xs:6px; --r-sm:10px; --r:16px; --r-card:22px; --r-lg:32px; --r-xl:46px; --r-pill:999px;\n  --sh-1:0 2px 4px rgba(13,20,38,.04);\n  --sh-2:0 18px 44px -20px rgba(13,20,38,.3);\n  --sh-3:0 40px 90px -34px rgba(13,20,38,.5);\n  --gut:clamp(18px,4.4vw,52px);\n  --band:clamp(62px,8vw,124px);\n  --band-sm:clamp(46px,5.4vw,84px);\n  --maxw:1320px;\n  --ff-head:\"Jost\",\"Jost Fallback\",\"Segoe UI\",system-ui,-apple-system,Arial,sans-serif;\n  --ff-body:\"Montserrat\",\"Montserrat Fallback\",\"Segoe UI\",system-ui,-apple-system,Arial,sans-serif;\n  --t:.24s; --t-slow:.55s; --ease:cubic-bezier(.4,.16,.2,1);\n}\n.wrap{width:100%;max-width:var(--maxw);margin-inline:auto;padding-inline:var(--gut)}\n.sprite{display:none}\n.site-footer .ic{width:18px;height:18px;fill:currentColor}\n.site-footer .socials .ic{width:19px;height:19px}\n/* ---------- footer ---------- */\n.site-footer{position:relative;background:#070c18;color:var(--d-body);font-size:.94rem;overflow:hidden}\n.site-footer>*{position:relative;z-index:1}\n.site-footer h3{font-family:var(--ff-head);font-size:.8rem;letter-spacing:.17em;text-transform:uppercase;color:#fff;margin:0 0 18px;font-weight:600}\n.site-footer h3.after-grid{margin-top:30px}\n.site-footer ul{list-style:none;margin:0;padding:0}\n.site-footer li{margin-bottom:0}\n.site-footer a{color:var(--d-body);text-decoration:none;display:inline-block;min-height:34px;padding-block:6px;line-height:1.5;transition:color var(--t) var(--ease)}\n.site-footer a:hover{color:#fff;text-decoration:underline}\n.f-grid{display:grid;grid-template-columns:1.6fr 1fr 1fr 1.25fr;gap:clamp(28px,3vw,56px);padding-block:clamp(52px,6vw,88px) clamp(40px,4.4vw,64px);align-items:start}\n.f-brand img{width:182px;margin-bottom:22px;background:#fff;padding:11px 14px;border-radius:var(--r)}\n.f-brand p{max-width:40ch;color:var(--d-muted)}\n.site-footer .f-contact{background:rgba(255,255,255,.055);border:1px solid var(--line-dark);border-radius:var(--r-card);padding:18px 20px}\n.f-contact li{display:flex;gap:.7em;align-items:flex-start;min-height:34px}\n.f-contact li+li{margin-top:6px}\n.f-contact span{padding-block:6px;min-width:0}\n.f-contact a,.f-contact span{overflow-wrap:anywhere}\n.f-contact .ic{color:#fff;background:var(--red);border-radius:50%;padding:6px;width:26px;height:26px;box-sizing:border-box;margin-top:7px;flex:none}\n.f-brands{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:14px}\n.socials{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px}\n.socials a{width:44px;height:44px;border-radius:50%;background:rgba(255,255,255,.09);display:grid;place-items:center;color:#fff;min-height:0;padding:0;transition:background-color var(--t) var(--ease),transform var(--t) var(--ease)}\n.socials a:hover{background:var(--red);transform:translateY(-3px)}\n.f-bar{border-top:1px solid rgba(255,255,255,.08);padding-top:24px;padding-bottom:clamp(82px,7vw,96px);display:flex;flex-wrap:wrap;gap:10px 30px;justify-content:space-between;align-items:center;font-size:.85rem;color:var(--d-muted)}\n.f-bar p{margin:0}\n.f-bar ul{display:flex;flex-wrap:wrap;gap:2px 24px}\n.f-bar li{margin:0}\n.f-bar a{min-height:30px;padding-block:4px}\n.built{display:inline-flex;align-items:center;gap:8px;white-space:nowrap;color:var(--d-muted)}\n.built img{width:20px;height:20px;flex:none;border-radius:var(--r-xs)}\n.built b{color:#fff;font-family:var(--ff-head);font-weight:600}\n</style>\n</footer>",
    "css": "\n:root{\n  --navy:#20386e; --navy-900:#0d1426; --navy-800:#121c33; --navy-700:#1a2b55;\n  --navy-600:#2b4a8c; --navy-400:#5f7cb8; --navy-300:#93a8d2; --navy-50:#eef2f9;\n  --red:#cb4236; --red-700:#a3332a; --red-600:#b93a2f; --red-300:#e8776c; --red-50:#fdefed;\n  --ink:#101728; --body:#5f6877; --muted:#7a8496;\n  --line:#e5e9f1; --line-2:#ccd4e2; --line-dark:rgba(255,255,255,.14);\n  --paper:#ffffff; --paper-2:#f5f7fb; --paper-3:#eef2f8;\n  --d-ink:#ffffff; --d-body:#c4d0e6; --d-muted:#8e9cba;\n  --r-xs:6px; --r-sm:10px; --r:16px; --r-card:22px; --r-lg:32px; --r-xl:46px; --r-pill:999px;\n  --sh-1:0 2px 4px rgba(13,20,38,.04);\n  --sh-2:0 18px 44px -20px rgba(13,20,38,.3);\n  --sh-3:0 40px 90px -34px rgba(13,20,38,.5);\n  --gut:clamp(18px,4.4vw,52px);\n  --band:clamp(62px,8vw,124px);\n  --band-sm:clamp(46px,5.4vw,84px);\n  --maxw:1320px;\n  --ff-head:\"Jost\",\"Jost Fallback\",\"Segoe UI\",system-ui,-apple-system,Arial,sans-serif;\n  --ff-body:\"Montserrat\",\"Montserrat Fallback\",\"Segoe UI\",system-ui,-apple-system,Arial,sans-serif;\n  --t:.24s; --t-slow:.55s; --ease:cubic-bezier(.4,.16,.2,1);\n}\n.wrap{width:100%;max-width:var(--maxw);margin-inline:auto;padding-inline:var(--gut)}\n.sprite{display:none}\n.site-footer .ic{width:18px;height:18px;fill:currentColor}\n.site-footer .socials .ic{width:19px;height:19px}\n/* ---------- footer ---------- */\n.site-footer{position:relative;background:#070c18;color:var(--d-body);font-size:.94rem;overflow:hidden}\n.site-footer>*{position:relative;z-index:1}\n.site-footer h3{font-family:var(--ff-head);font-size:.8rem;letter-spacing:.17em;text-transform:uppercase;color:#fff;margin:0 0 18px;font-weight:600}\n.site-footer h3.after-grid{margin-top:30px}\n.site-footer ul{list-style:none;margin:0;padding:0}\n.site-footer li{margin-bottom:0}\n.site-footer a{color:var(--d-body);text-decoration:none;display:inline-block;min-height:34px;padding-block:6px;line-height:1.5;transition:color var(--t) var(--ease)}\n.site-footer a:hover{color:#fff;text-decoration:underline}\n.f-grid{display:grid;grid-template-columns:1.6fr 1fr 1fr 1.25fr;gap:clamp(28px,3vw,56px);padding-block:clamp(52px,6vw,88px) clamp(40px,4.4vw,64px);align-items:start}\n.f-brand img{width:182px;margin-bottom:22px;background:#fff;padding:11px 14px;border-radius:var(--r)}\n.f-brand p{max-width:40ch;color:var(--d-muted)}\n.site-footer .f-contact{background:rgba(255,255,255,.055);border:1px solid var(--line-dark);border-radius:var(--r-card);padding:18px 20px}\n.f-contact li{display:flex;gap:.7em;align-items:flex-start;min-height:34px}\n.f-contact li+li{margin-top:6px}\n.f-contact span{padding-block:6px;min-width:0}\n.f-contact a,.f-contact span{overflow-wrap:anywhere}\n.f-contact .ic{color:#fff;background:var(--red);border-radius:50%;padding:6px;width:26px;height:26px;box-sizing:border-box;margin-top:7px;flex:none}\n.f-brands{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:14px}\n.socials{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px}\n.socials a{width:44px;height:44px;border-radius:50%;background:rgba(255,255,255,.09);display:grid;place-items:center;color:#fff;min-height:0;padding:0;transition:background-color var(--t) var(--ease),transform var(--t) var(--ease)}\n.socials a:hover{background:var(--red);transform:translateY(-3px)}\n.f-bar{border-top:1px solid rgba(255,255,255,.08);padding-top:24px;padding-bottom:clamp(82px,7vw,96px);display:flex;flex-wrap:wrap;gap:10px 30px;justify-content:space-between;align-items:center;font-size:.85rem;color:var(--d-muted)}\n.f-bar p{margin:0}\n.f-bar ul{display:flex;flex-wrap:wrap;gap:2px 24px}\n.f-bar li{margin:0}\n.f-bar a{min-height:30px;padding-block:4px}\n.built{display:inline-flex;align-items:center;gap:8px;white-space:nowrap;color:var(--d-muted)}\n.built img{width:20px;height:20px;flex:none;border-radius:var(--r-xs)}\n.built b{color:#fff;font-family:var(--ff-head);font-weight:600}\n",
