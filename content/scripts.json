{
  "header": "<!-- Google tag (gtag.js) -->\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-MM0H61E6D6\"></script>\n<script>\n  window.dataLayer = window.dataLayer || [];\n  function gtag(){dataLayer.push(arguments);}\n  gtag('js', new Date());\n\n  gtag('config', 'G-MM0H61E6D6');\n</script>\n\n<script>\n/* Sydney Hot Water Systems: Hot Water Systems page search + filters.\n   Site-wide script. The page importer strips scripts from page parts, so this\n   lives in the global header (inside <header>, like the site engine) or the\n   site custom code slot. It does nothing on pages without the .shws-range page. */\n(function () {\n  if (window.__shwsRange) { return; }\n  window.__shwsRange = true;\n  var d = document, SC = \".shws-range\", TOTAL = 116;\n  var css = d.createElement(\"style\");\n  css.id = \"shws-range-live\";\n  (d.head || d.documentElement).appendChild(css);\n\n  function root() { return d.querySelector(SC); }\n  function byId(id) { var r = root(); return r ? r.querySelector(\"#\" + id) : null; }\n\n  function tokens(v) {\n    v = String(v || \"\").toLowerCase()\n      .replace(/°/g, \" deg \").replace(/n\\/g/g, \" ng \")\n      .replace(/(\\d+)\\s*(litres?|liters?|ltrs?|lt|l)\\b/g, \"$1l\")\n      .replace(/(\\d+)\\s*(degrees?|deg)\\b/g, \"$1deg\")\n      .replace(/[^a-z0-9]+/g, \" \").trim();\n    return v ? v.split(\" \").slice(0, 8) : [];\n  }\n\n  function setText(el, t) { if (el && el.textContent !== t) { el.textContent = t; } }\n\n  function apply() {\n    var r = root(); if (!r) { return; }\n    var q = byId(\"shp-q\");\n    var toks = tokens(q ? q.value : \"\");\n    var rules = \"\";\n    toks.forEach(function (t) {\n      rules += SC + \" .shp-grid>li:not([data-s*=\\\" \" + t + \"\\\"]){display:none!important}\";\n    });\n    if (css.textContent !== rules) { css.textContent = rules; }\n\n    var n = 0, lis = r.querySelectorAll(\".shp-grid>li\");\n    for (var i = 0; i < lis.length; i++) { if (lis[i].getClientRects().length) { n++; } }\n\n    var b = byId(\"sb-all\"), t = byId(\"st-all\"), s = byId(\"sf-stock\");\n    var nf = (b && !b.checked ? 1 : 0) + (t && !t.checked ? 1 : 0) + (s && s.checked ? 1 : 0);\n    var active = nf + (toks.length ? 1 : 0);\n    var extra = \"\";\n    if (active) { extra += SC + \" .shp-status{display:flex!important}\"; }\n    if (n === 0) { extra += SC + \" .shp-empty{display:block!important}\" + SC + \" .shp-foot{display:none!important}\" + SC + \" .shp-status{visibility:hidden;height:0;margin:0!important;overflow:hidden}\"; }\n    if (css.textContent !== rules + extra) { css.textContent = rules + extra; }\n\n    var nodes = r.querySelectorAll(\".shp-live-n\");\n    for (var j = 0; j < nodes.length; j++) { setText(nodes[j], String(n)); }\n    var word = n === 1 ? \"system\" : \"systems\";\n    var live = r.querySelector(\".shp-live span\"); setText(live, word);\n    var ap = r.querySelector(\".shp-apply span\");\n    if (ap) { var apt = \"Show \" + n + \" \" + word; if (ap.textContent !== apt) { ap.innerHTML = \"Show <b class=\\\"shp-live-n\\\">\" + n + \"</b> \" + word; } }\n    var st = r.querySelector(\".shp-status span\");\n    if (st) { var stt = \"Showing \" + n + \" of \" + TOTAL + \" systems\"; if (st.textContent !== stt) { st.innerHTML = \"Showing <b class=\\\"shp-live-n\\\">\" + n + \"</b> of \" + TOTAL + \" systems\"; } }\n    setText(r.querySelector(\".shp-fbadge\"), nf ? String(nf) : \"\");\n    var tog = r.querySelector(\".shp-ftoggle\"), fo = byId(\"shp-fopen\");\n    if (tog && fo) { var ex = fo.checked ? \"true\" : \"false\"; if (tog.getAttribute(\"aria-expanded\") !== ex) { tog.setAttribute(\"aria-expanded\", ex); } }\n  }\n\n  /* keep the sticky bar tucked under the site header, whatever height it is at */\n  function pin() {\n    var r = root(); if (!r) { return; }\n    var bar = r.querySelector(\".shp-bar\"); if (!bar) { return; }\n    var h = d.getElementById(\"shws-header\"); if (!h) { return; }\n    var bt = Math.max(0, Math.round(h.getBoundingClientRect().bottom));\n    if (h.getBoundingClientRect().top > 1) { return; } /* header not stuck yet */\n    var v = bt + \"px\"; if (bar.style.top !== v) { bar.style.top = v; }\n  }\n  var ticking = false;\n  function onScroll() { if (ticking) { return; } ticking = true; requestAnimationFrame(function () { ticking = false; pin(); }); }\n\n  function toResults() {\n    var r = root(); if (!r) { return; }\n    var tgt = r.querySelector(\".shp-shop-in\"), bar = r.querySelector(\".shp-bar\");\n    if (!tgt) { return; }\n    var off = bar ? (parseFloat(getComputedStyle(bar).top) || 0) + bar.offsetHeight : 0;\n    var y = tgt.getBoundingClientRect().top + window.pageYOffset - off + 4;\n    if (Math.abs(y - window.pageYOffset) > 2) { window.scrollTo({ top: Math.max(0, y), behavior: \"smooth\" }); }\n  }\n  function resultsAbove() {\n    var r = root(); if (!r) { return false; }\n    var tgt = r.querySelector(\".shp-shop-in\"), bar = r.querySelector(\".shp-bar\");\n    if (!tgt || !bar) { return false; }\n    return tgt.getBoundingClientRect().top < bar.getBoundingClientRect().bottom - 2;\n  }\n\n  function stickOff(bar) { return (parseFloat(getComputedStyle(bar).top) || 0) + bar.offsetHeight; }\n  function panelHidden() {\n    var r = root(); var p = r && r.querySelector(\".shp-panel\"), bar = r && r.querySelector(\".shp-bar\");\n    if (!p || !bar) { return false; }\n    return p.getBoundingClientRect().top < bar.getBoundingClientRect().bottom - 4;\n  }\n  function toPanel() {\n    var r = root(); var p = r && r.querySelector(\".shp-panel\"), bar = r && r.querySelector(\".shp-bar\");\n    if (!p || !bar) { return; }\n    var y = p.getBoundingClientRect().top + window.pageYOffset - stickOff(bar);\n    if (y < window.pageYOffset - 2) { window.scrollTo({ top: Math.max(0, y), behavior: \"auto\" }); }\n  }\n\n  function resetAll() {\n    [\"sb-all\", \"st-all\"].forEach(function (id) { var e = byId(id); if (e) { e.checked = true; } });\n    var s = byId(\"sf-stock\"); if (s) { s.checked = false; }\n    var q = byId(\"shp-q\"); if (q) { q.value = \"\"; }\n    apply();\n  }\n\n  var timer = null;\n  d.addEventListener(\"input\", function (e) {\n    var el = e.target;\n    if (!el || el.id !== \"shp-q\" || !el.closest(SC)) { return; }\n    clearTimeout(timer);\n    timer = setTimeout(function () { var wasAbove = resultsAbove(); apply(); if (wasAbove) { toResults(); } }, 120);\n  });\n  d.addEventListener(\"change\", function (e) {\n    var el = e.target;\n    if (!el || !el.closest || !el.closest(SC)) { return; }\n    if (el.matches(\".shws-state, #shp-q\")) { apply(); }\n  });\n  d.addEventListener(\"keydown\", function (e) {\n    var el = e.target; if (!el || !el.closest || !el.closest(SC)) { return; }\n    if (el.id === \"shp-q\" && (e.key === \"Enter\" || e.keyCode === 13)) {\n      e.preventDefault(); clearTimeout(timer); apply(); el.blur(); toResults(); return;\n    }\n    if (el.id === \"shp-q\" && e.key === \"Escape\") { el.value = \"\"; apply(); return; }\n    if (el.matches(\"label[role=button]\") && (e.key === \"Enter\" || e.key === \" \")) { e.preventDefault(); el.click(); }\n  });\n  d.addEventListener(\"click\", function (e) {\n    var el = e.target; if (!el || !el.closest) { return; }\n    var r = el.closest(SC); if (!r) { return; }\n    if (el.closest(\"[data-shp-clear-q]\")) {\n      e.preventDefault(); var q = byId(\"shp-q\"); if (q) { q.value = \"\"; apply(); q.focus(); } return;\n    }\n    if (el.closest(\"[data-shp-reset]\")) { e.preventDefault(); resetAll(); toResults(); return; }\n    /* Toggle our own hidden inputs directly, so the browser never focuses (and scrolls to) them */\n    var lab = el.closest(\"label[for]\");\n    var inp = lab ? byId(lab.getAttribute(\"for\")) : null;\n    if (inp && r.contains(inp) && inp.classList.contains(\"shws-state\")) {\n      e.preventDefault();\n      if (inp.id === \"shp-fopen\" && lab.classList.contains(\"shp-ftoggle\")) {\n        /* open panel scrolled out of sight above: bring it back rather than closing it */\n        if (inp.checked && panelHidden()) { toPanel(); return; }\n        inp.checked = !inp.checked; inp.dispatchEvent(new Event(\"change\", { bubbles: true }));\n        if (inp.checked) { toPanel(); }\n        return;\n      }\n      if (inp.type === \"radio\") { if (inp.checked) { apply(); } else { inp.checked = true; inp.dispatchEvent(new Event(\"change\", { bubbles: true })); } }\n      else { inp.checked = !inp.checked; inp.dispatchEvent(new Event(\"change\", { bubbles: true })); }\n      if (lab.hasAttribute(\"data-shp-apply\")) { setTimeout(toResults, 30); }\n      return;\n    }\n  });\n\n  function boot() {\n    var q = byId(\"shp-q\");\n    if (q && !q.value && !boot.done) {\n      try { var p = new URLSearchParams(window.location.search).get(\"q\"); if (p) { q.value = p.slice(0, 60); } } catch (err) {}\n    }\n    if (q) { boot.done = true; }\n    apply(); pin();\n  }\n  if (d.readyState === \"loading\") { d.addEventListener(\"DOMContentLoaded\", boot); } else { boot(); }\n  window.addEventListener(\"load\", boot);\n  window.addEventListener(\"scroll\", onScroll, { passive: true });\n  window.addEventListener(\"resize\", onScroll, { passive: true });\n  window.addEventListener(\"pageshow\", boot);\n\n  var pend = null;\n  new MutationObserver(function (list) {\n    for (var i = 0; i < list.length; i++) { if (list[i].target === css || css.contains(list[i].target)) { return; } }\n    clearTimeout(pend); pend = setTimeout(boot, 150);\n  }).observe(d.body || d.documentElement, { childList: true, subtree: true });\n})();\n</script>",
